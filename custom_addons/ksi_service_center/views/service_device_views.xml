<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_service_device_tree" model="ir.ui.view">
        <field name="name">service.device.tree</field>
        <field name="model">service.device</field>
        <field name="arch" type="xml">
            <tree string="Model Perangkat">
                <field name="name"/>
                <field name="brand"/>
                <field name="device_type"/>
                <field name="default_warranty_months"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_service_device_form" model="ir.ui.view">
        <field name="name">service.device.form</field>
        <field name="model">service.device</field>
        <field name="arch" type="xml">
            <form string="Model Perangkat">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="ticket_count" widget="statinfo" string="Riwayat Servis"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Nama Model Perangkat"/>
                        <h1>
                            <field name="name" placeholder="contoh: Axioo Hype 5"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="brand"/>
                            <field name="device_type"/>
                        </group>
                        <group>
                            <field name="default_warranty_months"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Spesifikasi" name="specs">
                            <field name="description" placeholder="Catatan spesifikasi teknis perangkat..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_service_device" model="ir.actions.act_window">
        <field name="name">Master Perangkat</field>
        <field name="res_model">service.device</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tambahkan model perangkat baru (Axioo, dsb.)
            </p>
        </field>
    </record>
</odoo>
