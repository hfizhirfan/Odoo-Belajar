<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_member_tree" model="ir.ui.view">
        <field name="name">library.member.tree</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <tree>
                <field name="member_number"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="active_loan_count"/>
            </tree>
        </field>
    </record>

    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nama anggota..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_number"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Riwayat Peminjaman">
                            <field name="loan_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="book_id"/>
                                    <field name="loan_date"/>
                                    <field name="due_date"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Anggota</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
