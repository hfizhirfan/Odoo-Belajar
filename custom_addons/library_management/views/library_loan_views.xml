<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_loan_search" model="ir.ui.view">
        <field name="name">library.loan.search</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <filter name="active_loans" string="Sedang Dipinjam" domain="[('state', '=', 'borrowed')]"/>
                <filter name="late" string="Terlambat" domain="[('state', '=', 'borrowed'), ('due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_member" string="Anggota" context="{'group_by': 'member_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_library_loan_tree" model="ir.ui.view">
        <field name="name">library.loan.tree</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <tree decoration-danger="days_late &gt; 0" decoration-success="state == 'returned'">
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="loan_date"/>
                <field name="due_date"/>
                <field name="days_late"/>
                <field name="fine_amount"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_borrow" string="Pinjamkan" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_return" string="Kembalikan" type="object" class="btn-primary" invisible="state != 'borrowed'"/>
                    <button name="action_cancel" string="Batalkan" type="object" invisible="state not in ('draft', 'borrowed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,borrowed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id" readonly="state != 'draft'"/>
                            <field name="book_id" domain="[('state', '=', 'available')]" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="loan_date" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state != 'draft'"/>
                            <field name="return_date" invisible="not return_date"/>
                        </group>
                    </group>
                    <group string="Keterlambatan" invisible="days_late == 0">
                        <field name="days_late"/>
                        <field name="fine_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Peminjaman</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_library_loan_search"/>
    </record>
</odoo>
